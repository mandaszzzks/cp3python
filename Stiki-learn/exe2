from sklearn.svm import SVC
from sklearn.neighbors import KNeighborsClassifier
from sklearn.model_selection import GridSearchCV

def com_scaler(modelo):
    return Pipeline([('scaler', StandardScaler()), ('clf', modelo)])

modelos = {
    'RandomForest': com_scaler(RandomForestClassifier(random_state=42)),
    'SVM': com_scaler(SVC()),
    'KNN': com_scaler(KNeighborsClassifier(n_neighbors=3)),
}
medias = {nome: cross_val_score(m, X, y, cv=5).mean() for nome, m in modelos.items()}
for nome, media in medias.items():
    print('%s: %.2f' % (nome, media))

vencedor = max(medias, key=medias.get)
print('Vencedor:', vencedor)

grades = {
    'RandomForest': {'clf__n_estimators': [50, 100, 200], 'clf__max_depth': [None, 5, 10]},
    'SVM': {'clf__C': [0.1, 1, 10], 'clf__kernel': ['linear', 'rbf']},
    'KNN': {'clf__n_neighbors': [1, 3, 5]},
}
busca = GridSearchCV(modelos[vencedor], grades[vencedor], cv=5)
busca.fit(X, y)
print('Melhores parâmetros:', busca.best_params_)
print('Melhor score: %.2f' % busca.best_score_)