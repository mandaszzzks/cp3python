import os
import mysql.connector

con = mysql.connector.connect(host='localhost', user='root',
                              password=os.environ['MYSQL_PASSWORD'], database='seguranca')
cur = con.cursor()
cur.execute(
    'CREATE TABLE IF NOT EXISTS alertas ('
    'id INT AUTO_INCREMENT PRIMARY KEY, tipo VARCHAR(50), descricao TEXT, '
    'ip_origem VARCHAR(45), '
    "severidade ENUM('baixa','media','alta','critica'), "
    'criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP)'
)

dados = [
    ('BRUTE_FORCE', '10 falhas', '185.220.101.1', 'critica'),
    ('BRUTE_FORCE', '8 falhas',  '185.220.101.1', 'critica'),
    ('BRUTE_FORCE', '6 falhas',  '185.220.101.1', 'alta'),
    ('BRUTE_FORCE', '5 falhas',  '185.220.101.1', 'alta'),
    ('PORT_SCAN', 'scan', '45.33.32.156', 'alta'),
    ('PORT_SCAN', 'scan', '45.33.32.156', 'media'),
    ('PORT_SCAN', 'scan', '45.33.32.156', 'critica'),
    ('XSS', 'script na URL', '91.240.118.172', 'alta'),
    ('XSS', 'script na URL', '91.240.118.172', 'media'),
    ('SQLI', 'aspas na URL', '10.0.0.7', 'baixa'),
]
cur.executemany('INSERT INTO alertas (tipo, descricao, ip_origem, severidade) VALUES (%s, %s, %s, %s)', dados)
con.commit()

def mostrar(titulo, sql):
    cur.execute(sql)
    print('=== %s ===' % titulo)
    for chave, total in cur.fetchall():
        print('%s -> %d' % (chave, total))

mostrar('Por severidade', 'SELECT severidade, COUNT(*) FROM alertas GROUP BY severidade ORDER BY COUNT(*) DESC')
mostrar('Por tipo', 'SELECT tipo, COUNT(*) FROM alertas GROUP BY tipo ORDER BY COUNT(*) DESC')
mostrar('Top IPs de origem', 'SELECT ip_origem, COUNT(*) FROM alertas GROUP BY ip_origem ORDER BY COUNT(*) DESC LIMIT 5')
con.close()