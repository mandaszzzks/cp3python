import numpy as np
from sklearn.ensemble import IsolationForest

# [hora_do_dia, tentativas_login, bytes_baixados]
acessos = np.array([
    [9, 1, 200], [10, 1, 500], [14, 2, 300], [11, 1, 250], [16, 1, 400],
    [3, 40, 900000], [10, 1, 350], [15, 2, 280], [2, 55, 800000],
])

# contamination = quanto eu acho que é anomalia. 9 amostras x 0.25 ≈ 2
detector = IsolationForest(contamination=0.25, random_state=42)
resultado = detector.fit_predict(acessos)   # 1 = normal, -1 = anomalia

for i, (amostra, r) in enumerate(zip(acessos, resultado)):
    print('Amostra %d: %s -> %s' % (i, amostra.tolist(), 'ANOMALIA' if r == -1 else 'Normal'))