import os
from datetime import datetime
from pymongo import MongoClient

col = MongoClient(os.environ.get('MONGO_URI', 'mongodb://localhost:27017/'))['seguranca']['eventos']
col.delete_many({'fonte': 'auth'})

docs = []
ignoradas = 0
try:
    with open('auth.log', encoding='utf-8') as f:
        for linha in f:
            partes = linha.split()
            if len(partes) < 5:
                continue
            try:
                quando = datetime.strptime(partes[0] + ' ' + partes[1], '%Y-%m-%d %H:%M:%S')
            except ValueError:
                ignoradas += 1
                continue
            campos = dict(p.split('=', 1) for p in partes[3:] if '=' in p)
            docs.append({
                'timestamp': quando,
                'fonte': 'auth',
                'tipo': partes[2],
                'ip': campos.get('ip'),
                'detalhes': {'usuario': campos.get('usuario')},
            })
except FileNotFoundError:
    print('auth.log não encontrado')
    raise SystemExit(1)

if docs:
    col.insert_many(docs)

pipeline = [
    {'$match': {'tipo': 'FAIL'}},
    {'$group': {'_id': '$ip', 'total': {'$sum': 1}}},
    {'$sort': {'total': -1}},
    {'$limit': 5},
]
print('=== Top IPs por falhas de login ===')
for l in col.aggregate(pipeline):
    print('%s -> %d falhas' % (l['_id'], l['total']))
print('Total de eventos inseridos:', len(docs))
if ignoradas:
    print('Linhas ignoradas (data inválida):', ignoradas)